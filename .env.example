CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoixxxxxxxxxxxxxxxx

# Zigbee2MQTT network encryption secrets — MUST be changed before first run
# Generate a new 16-byte network key with:
#   python3 -c "import os, json; print(json.dumps(list(os.urandom(16))))"
ZIGBEE2MQTT_NETWORK_KEY=REPLACE_WITH_16_BYTE_JSON_ARRAY
ZIGBEE2MQTT_PAN_ID=REPLACE_WITH_YOUR_PAN_ID
ZIGBEE2MQTT_EXT_PAN_ID=REPLACE_WITH_8_BYTE_JSON_ARRAY
