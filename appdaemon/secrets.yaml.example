# appdaemon/secrets.yaml.example — Template for appdaemon/secrets.yaml
# Copy this file to appdaemon/secrets.yaml and fill in real values.
# NEVER commit secrets.yaml — it is gitignored.

# Home coordinates
latitude: 40.4168
longitude: -3.7038
elevation: 667

# Home Assistant URL (internal Docker network name)
ha_url: "http://homeassistant:8123"

# Long-lived access token from HA Profile page
appdaemon_token: "your_long_lived_access_token_here"

# LLM API (OpenAI-compatible; also works with local Ollama)
llm_api_url: "https://api.openai.com/v1"
llm_api_key: "sk-your-openai-api-key-here"
llm_model: "gpt-4o-mini"
