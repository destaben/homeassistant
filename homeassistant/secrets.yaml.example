# secrets.yaml.example — Template for homeassistant/secrets.yaml
# Copy this file to homeassistant/secrets.yaml and fill in real values.
# NEVER commit secrets.yaml — it is gitignored.

# --- Home coordinates (used by HA and AppDaemon) ---
latitude: 40.4168
longitude: -3.7038
elevation: 667

# --- Home Assistant internal URL ---
ha_url: "http://homeassistant:8123"

# --- AppDaemon long-lived access token ---
# Generate via HA Profile → Long-Lived Access Tokens
appdaemon_token: "your_long_lived_access_token_here"

# --- LLM / AI Agent settings ---
# Supports any OpenAI-compatible endpoint (OpenAI, Azure OpenAI, local Ollama, etc.)
# OpenAI example:   https://api.openai.com/v1
# Ollama example:   http://ollama:11434/v1
llm_api_url: "https://api.openai.com/v1"
llm_api_key: "sk-your-openai-api-key-here"
llm_model: "gpt-4o-mini"
