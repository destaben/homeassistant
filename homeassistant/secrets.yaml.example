# Archivo de secretos de Home Assistant
# NO VERSIONAR - TODOS LOS VALORES DEBEN SER REEMPLAZADOS
# Lee más en: https://www.home-assistant.io/docs/configuration/secrets/

# API Keys
google_api_key: "your-api-key-here"
openweather_api_key: "your-api-key-here"

# Credenciales
my_username: "tu_usuario"
my_password: "tu_contraseña"

# URLs y Dominios
external_url: "https://homeassistant.tu-dominio.com"
internal_url: "http://192.168.1.xxx:8123"

# MQTT
mqtt_user: "usuario_mqtt"
mqtt_password: "contraseña_mqtt"

# Otros servicios
latitude: 40.416775
longitude: -3.703790

# Meshtastic LoRa Mesh — MQTT topics por nodo
# Formato: msh/<REGION>/2/json/<CHANNEL>/!<NODE_HEX_ID>
# El NODE_HEX_ID se encuentra en la app Meshtastic → Radio Config → Device
# Ejemplo con región EU_868 y canal LongFast:
meshtastic_d3st_topic: "msh/EU_868/2/json/LongFast/!d3st_hex_id"
meshtastic_layana_topic: "msh/EU_868/2/json/LongFast/!layana_hex_id"
