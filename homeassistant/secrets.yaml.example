# Copy this file to secrets.yaml and fill in real values.
# Never commit secrets.yaml — it is gitignored.

# MQTT broker credentials (must match /etc/mosquitto/passwd on the host)
mqtt_username: homeassistant
mqtt_password: CHANGE_ME

# Zigbee2MQTT MQTT credentials (set the same password in data/configuration.yaml)
mqtt_z2m_username: zigbee2mqtt
mqtt_z2m_password: CHANGE_ME
