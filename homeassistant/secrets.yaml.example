# secrets.yaml.example — copy to secrets.yaml and fill in real values
# This file is tracked by git; secrets.yaml is gitignored.
#
# Usage in config files:  some_key: !secret my_secret_name

# ── Internal network ─────────────────────────────────────────────────────────
# Base URL used for local snapshot attachment links in notifications
ha_base_url: "http://192.168.1.x:8123"

# ── Mobile notifications ──────────────────────────────────────────────────────
# Notification service for the secondary household phone (e.g. Android)
notify_secondary_phone: notify.mobile_app_sm_a346b

# ── LLM Vision (llmvision integration) ───────────────────────────────────────
# Provider name as recognised by the llmvision integration.
# Cloud options: OpenAI | Google | Anthropic
# Local option:  Ollama  (requires the Ollama container — see docker-compose.yaml)
llmvision_provider: OpenAI

# Model identifier for the chosen provider.
# OpenAI examples : gpt-4o-mini | gpt-4o
# Google examples : gemini-1.5-flash | gemini-1.5-pro
# Ollama examples : llava:13b | moondream
llmvision_model: gpt-4o-mini

# ── Cloudflare tunnel (optional — only needed for external access) ────────────
# CLOUDFLARE_TUNNEL_TOKEN is set in .env, not here.
# See .env.example for reference.
