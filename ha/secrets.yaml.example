# Copy this file to secrets.yaml and fill in real values.
# Never commit secrets.yaml — it is gitignored.

# MQTT broker credentials (must match /etc/mosquitto/passwd on the host)
mqtt_username: homeassistant
mqtt_password: CHANGE_ME

# Zigbee2MQTT MQTT credentials (set the same password in zigbee2mqtt/configuration.yaml)
mqtt_z2m_username: zigbee2mqtt
mqtt_z2m_password: CHANGE_ME

# Wake-on-LAN targets (Ethernet interface MAC and a fixed/reserved IP for each laptop)
wol_broadcast_address: 192.168.1.255
wol_macbook_air_mac: "AA:BB:CC:DD:EE:01"
wol_macbook_air_host: 192.168.1.101
wol_macbook_neo_mac: "AA:BB:CC:DD:EE:02"
wol_macbook_neo_host: 192.168.1.102
